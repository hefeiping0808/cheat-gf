# 可选：统一覆盖 DEV/PRO 地址；留空时按 Vite mode 选择下面的地址
VITE_API_BASE_URL=
# 开发环境 GoFrame 地址，Admin 的 HTTP 和 WebSocket 都使用此地址
VITE_DEV_API_BASE_URL=http://localhost:8000
# 生产环境 GoFrame 地址；如果前后端同源部署，可留空并使用相对请求
VITE_PRO_API_BASE_URL=
# 可选：App 答题端地址，用于从访客管理跳转到 module 页面
VITE_APP_BASE_URL=
VITE_DEV_APP_BASE_URL=http://localhost:5173
VITE_PRO_APP_BASE_URL=
# 只有联调 Mock 时显式打开
VITE_ENABLE_MOCK=false
